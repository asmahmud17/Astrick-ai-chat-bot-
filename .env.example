# Environment Variables Example for Anas Mahmud Portfolio
# Copy this file to .env locally or set these in Firebase/Cloud Run environment variables

# Contact Email Config
VITE_CONTACT_EMAIL=YOUR_EMAIL@example.com

# Firebase Configuration (Optional - for persistent contact submissions & analytics)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
